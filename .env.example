# Copie ce fichier en .env.local et renseigne tes valeurs Supabase.

# --- Supabase (obligatoire) — Dashboard Supabase → Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_PUBLISHABLE

# --- Identifiant de CETTE borne (multi-postes) ---
NEXT_PUBLIC_BORNE_ID=borne-1

# --- Moteur OCR du scan continu : tesseract (recommandé) | neural ---
NEXT_PUBLIC_OCR_ENGINE=tesseract
NEXT_PUBLIC_TROCR_MODEL=Xenova/trocr-small-printed

# --- Analyse IA (Ollama, optionnel) ---
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
NEXT_PUBLIC_OLLAMA_MODEL=gemma3:4b
